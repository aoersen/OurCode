# Dependencies
node_modules/

# Build outputs
dist/
dist-electron/
out/
release/
release-*/
test-results/
coverage/

# Playwright
playwright-report/

# @playwright/mcp runtime data (console logs, page snapshots)
.playwright-mcp/

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Runtime-generated MCP test config dirs
electron/__tests__/fixtures/mcp-config-*/
electron/__tests__/fixtures/mcp-http-config-*/

# Local MCP runtime config (may contain real API keys; the tracked template is mcp_config.example.json)
mcp_config.json

# Downloaded release artifacts (build cache)
.downloads/

# Stitch design tool runtime data (tokens/screenshots/backups, regenerated by tools/stitch-design-system.mjs)
.stitch/

# ZCode agent workspace data (session plans, local tool state)
.zcode/

# One-off debug repro scripts & screenshots (bug investigation, not project tooling)
tools/repro-*.*
.ourcode/targemode/

# e2e debug screenshots (cursor/caret/hit probes during bug investigation)
e2e/*.png

# Docs (not committed per user request) — except the Computer Use design doc,
# which ships with the feature it specifies.
docs/*
!docs/COMPUTER_USE.md

# WeChat Agent sandbox (dev: created next to the app in the repo root)
wechat-agent/

# Bundled whisper.cpp binaries + models (pulled by `npm run fetch-whisper`; too large for git)
resources/whisper/bin/
resources/whisper/models/*.bin
resources/whisper/.whisper-bin.zip

# scratch downloads / test audio
.tmp/

# CDP smoke log (scripts/browser-cdp-smoke.mjs)
scripts/.cdp-smoke.log
