{
  "name": "ourcode-ide",
  "version": "0.2.13",
  "description": "AI-powered code editor with multi-provider support and editable chat history",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node node_modules/@playwright/test/cli.js test"
  },
  "overrides": {
    "playwright": "$@playwright/test",
    "playwright-core": "$@playwright/test"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^11.0.0",
    "chardet": "^2.0.0",
    "chokidar": "^3.6.0",
    "dompurify": "^3.4.13",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "gsap": "^3.15.0",
    "iconv-lite": "^0.6.3",
    "node-machine-id": "^1.1.12",
    "node-pty": "^1.1.0",
    "three": "^0.185.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.79",
    "@playwright/test": "^1.45.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/marked": "^5.0.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.2",
    "marked-highlight": "^2.1.0",
    "monaco-editor": "^0.50.0",
    "postcss": "^8.4.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vitest": "^2.0.0",
    "zustand": "^4.5.4"
  },
  "build": {
    "appId": "com.ourcode.ide",
    "productName": "OurCode IDE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron",
      "build"
    ],
    "extraResources": [
      {
        "from": "mcp-servers",
        "to": "mcp-servers"
      },
      {
        "from": "tools/ripgrep/${os}/${arch}",
        "to": "tools/ripgrep"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "OurCode-IDE-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "OurCode-IDE-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "OurCode-IDE-Portable-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "artifactName": "OurCode-IDE-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "artifactName": "OurCode-IDE-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "aoersen",
      "repo": "OurCode"
    }
  }
}
