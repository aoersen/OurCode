# Normalize line endings: source files are stored as LF in the repo and
# checked out as LF on all platforms (the default core.autocrlf behavior on
# Windows kept flipping files and spamming CRLF warnings on every commit).
* text=auto eol=lf

# Source & config
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.bat text eol=crlf

# Scripts with shebangs must keep LF
*.sh text eol=lf

# Encrypted prompt presets: ciphertext changes wholesale on every re-encode,
# so a line-by-line diff is pure noise (and reveals nothing useful).
src/services/noLimits/presets/*.enc.json -diff

# Binary (never normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.zip binary
*.asar binary
*.exe binary
*.dll binary
*.db binary
*.sqlite binary
